# Copy to backend/.env for local runs. All values are optional.

# SQLite (default) or MariaDB, e.g.:
# DATABASE_URL=mysql+pymysql://satire:satire@localhost:3306/satire?charset=utf8mb4
# DATABASE_URL=sqlite:///./databases/database.db

SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=*

UPLOADS_DIR=uploads
MAX_IMAGE_DIM=1600
AVIF_QUALITY=60
VIDEO_CODEC=auto
VIDEO_CRF=30
MAX_UPLOAD_MB=50

STARTING_BALANCE=1000

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@satirex.local
ADMIN_PASSWORD=admin1234
