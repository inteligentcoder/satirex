# Copy to .env and adjust before running `docker compose up --build`.

# MariaDB
MARIADB_ROOT_PASSWORD=rootpass
MARIADB_DATABASE=satire
MARIADB_USER=satire
MARIADB_PASSWORD=satire

# Backend
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@satirex.local
ADMIN_PASSWORD=admin1234
CORS_ORIGINS=*
VIDEO_CODEC=auto

# Frontend build arg: how the browser reaches the backend.
VITE_API_BASE=http://localhost:8000
